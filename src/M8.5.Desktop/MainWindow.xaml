<Window x:Class="TrackerOfTime.V2.M8_5.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:interop="clr-namespace:TrackerOfTime.V2.M8_5.Desktop.Interop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Tracker of Time V2" Width="1600" Height="960" MinWidth="1280" MinHeight="800" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#020503" Closing="Window_Closing">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="9" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid x:Name="ThemeRoot" Background="{DynamicResource WindowBackground}" ClipToBounds="True">
  <!-- Full illustrated-style window frame: the filigree is part of the shell, not decoration scattered over it. -->
  <Image x:Name="ThemeBackdropImage" Source="/TrackerOfTime.V2.M8.5.Desktop;component/Assets/Hyrule/hyrule_cinematic.jpg" Stretch="UniformToFill" Opacity="0.30" IsHitTestVisible="False"/>
  <Border x:Name="ThemeOuterFrame" Margin="0" Background="{DynamicResource ThemeFrameFill}" BorderBrush="{DynamicResource ThemeFrame}" BorderThickness="2" CornerRadius="9"/>
  <Image x:Name="ThemeCornerLeft" Source="/TrackerOfTime.V2.M8.5.Desktop;component/Assets/Hyrule/organic_corner.png" Width="150" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" IsHitTestVisible="False"/>
  <Image x:Name="ThemeCornerRight" Source="/TrackerOfTime.V2.M8.5.Desktop;component/Assets/Hyrule/organic_corner.png" Width="150" Height="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"><Image.RenderTransform><ScaleTransform ScaleX="-1"/></Image.RenderTransform></Image>
  <Grid Margin="2">
  <Grid>
   <Grid.RowDefinitions><RowDefinition x:Name="ThemeHeaderRow" Height="102"/><RowDefinition Height="*"/><RowDefinition x:Name="ThemeStatusRow" Height="34"/></Grid.RowDefinitions>
   <!-- Hyrule game-shell: illustrated atmosphere + integrated navigation -->
   <Border x:Name="ThemeHeaderShell" Grid.Row="0" Background="{DynamicResource HeaderMaterial}" BorderThickness="0" CornerRadius="3,3,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" ClipToBounds="True">
    <Grid>
     <Image x:Name="ThemeHeaderImage" Source="/TrackerOfTime.V2.M8.5.Desktop;component/Assets/Hyrule/hyrule_cinematic.jpg" Stretch="UniformToFill" Opacity="1" VerticalAlignment="Stretch"/>
     <Grid Margin="14,7,12,7">
      <!-- illustrated logo plate, not a generic rectangle -->
      <Grid Width="342" Height="82" HorizontalAlignment="Left" VerticalAlignment="Center">
       <Image x:Name="ThemeLogoFrame" Source="/TrackerOfTime.V2.M8.5.Desktop;component/Assets/Hyrule/logo_frame.png" Stretch="Fill"/>
       <Grid Margin="25,12,28,14"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="64" Height="56" VerticalAlignment="Center"><Polygon Points="32,0 16,28 48,28" Fill="#F1CB58"/><Polygon Points="15,30 0,56 30,56" Fill="#D9A83A"/><Polygon Points="49,30 34,56 64,56" Fill="#E9BD49"/></Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="TRACKER OF TIME V2" FontFamily="Georgia" FontWeight="Bold" Foreground="#F5D777" FontSize="22"/></StackPanel>
       </Grid>
      </Grid>
      <!-- navigation is seated into the lower ornamental rail -->
      <Grid Margin="345,0,0,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="82"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <Button Style="{StaticResource NavButton}" Content="⌂  Home" Click="Home_Click"/><Button Style="{StaticResource NavButton}" Content="⚒  Randomizer" Click="Randomizer_Click"/><Button Style="{StaticResource ActiveNavButton}" Content="🎮  Play" Click="Play_Click"/><Button Style="{StaticResource NavButton}" Content="☷  Tracker" Click="TrackerPage_Click"/><Button Style="{StaticResource NavButton}" Content="▰  Map" Click="Map_Click"/><Button Style="{StaticResource NavButton}" Content="⚙  Settings" Click="Settings_Click"/>
       </StackPanel>
       <ComboBox x:Name="ThemeSelector" Grid.Column="1" Margin="4,0" Height="42" SelectionChanged="ThemeSelector_SelectionChanged"><ComboBoxItem IsSelected="True">Hyrule</ComboBoxItem><ComboBoxItem>Zora</ComboBoxItem><ComboBoxItem>Gerudo</ComboBoxItem><ComboBoxItem>Ocarina of Time</ComboBoxItem><ComboBoxItem>Nightly</ComboBoxItem><ComboBoxItem>Midnight</ComboBoxItem><ComboBoxItem>Simple Dark</ComboBoxItem><ComboBoxItem>Light Parchment</ComboBoxItem></ComboBox>
       <Button x:Name="LanguageSwitchButton" Grid.Column="2" Margin="4,0" Height="42" Content="🌐  DE" Click="LanguageSwitch_Click" ToolTip="Deutsch / English"/>
       <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Width="34" Height="34" Padding="0" Content="—" Click="Minimize_Click"/><Button Width="34" Height="34" Padding="0" Content="□" Click="Maximize_Click"/><Button Width="34" Height="34" Padding="0" Content="×" Click="Close_Click"/></StackPanel>
      </Grid>
     </Grid>
    </Grid>
   </Border>
   <Grid Grid.Row="1" x:Name="RandomizerPage" Visibility="Collapsed"><ContentControl x:Name="RandomizerWorkspaceHost"/></Grid>

   <Grid Grid.Row="1" x:Name="TrackerWorkspace" Visibility="Collapsed" Margin="8,7,8,6">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource PanelBorder}" Padding="14,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="☷  TRACKER WORKSPACE" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="TrackerWorkspaceStateText" Text="Wartet auf Live-Daten." Foreground="#9DAA9F" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TrackerWorkspaceEvidenceText" Text="Status: —" Foreground="#E8D69E" Margin="0,0,18,0"/><TextBlock x:Name="TrackerWorkspaceCapturedText" Text="Datenstand: —" Foreground="#9DAA9F"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource PanelBorder}" Margin="0,0,6,0" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="INVENTAR • AUSRÜSTUNG • QUEST • SONGS" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><UniformGrid x:Name="TrackerWorkspaceLiveGrid" Columns="7" HorizontalAlignment="Left" VerticalAlignment="Top"/></ScrollViewer></Grid></Border>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource PanelBorder}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="DUNGEONS &amp; SCHLÜSSEL" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TrackerWorkspaceDungeonPanel"/></ScrollViewer></Grid></Border>
      <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,6,0,0"><StackPanel><TextBlock Text="LIVE FORTSCHRITT" Foreground="#E3BB4C" FontWeight="Bold"/><UniformGrid Columns="2" Margin="0,6,0,0"><TextBlock x:Name="TrackerWorkspaceItemsText" Text="Items 0" Margin="3"/><TextBlock x:Name="TrackerWorkspaceEquipmentText" Text="Ausrüstung 0" Margin="3"/><TextBlock x:Name="TrackerWorkspaceSongsText" Text="Songs 0 / 12" Margin="3"/><TextBlock x:Name="TrackerWorkspaceQuestText" Text="Quest 0" Margin="3"/><TextBlock x:Name="TrackerWorkspaceDungeonsText" Text="Dungeons 0" Margin="3"/><TextBlock x:Name="TrackerWorkspaceChecksText" Text="Checks 0 / 0" Margin="3"/></UniformGrid><Separator Margin="0,5"/><TextBlock x:Name="TrackerWorkspaceRegionText" Text="Region: —" Foreground="#C9B36D"/><TextBlock Text="Die Anzeige zeigt ausschließlich gelesene Live-Daten; Klicks verändern keinen Spielzustand." Foreground="#829087" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
     </Grid>
    </Grid>
   </Grid>

   <Grid Grid.Row="1" x:Name="HomeWorkspace" Visibility="Collapsed" Margin="8,7,8,6">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource PanelBorder}" Padding="14,8"><StackPanel><TextBlock Text="⌂  HOME" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold" FontSize="18"/><TextBlock Text="Session-Dashboard • echte Zustände aus Play, GameCore und Tracker" Foreground="#9DAA9F" FontSize="10"/></StackPanel></Border>
    <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource PanelBorder}" Margin="0,0,6,0" Padding="14"><StackPanel><TextBlock Text="SPIEL &amp; SESSION" Foreground="#E3BB4C" FontWeight="Bold"/><TextBlock x:Name="HomeGameText" Text="Keine ROM ausgewählt" FontSize="22" FontFamily="Georgia" Foreground="#F1D477" Margin="0,12,0,3" TextWrapping="Wrap"/><TextBlock x:Name="HomeProfileText" Text="Profil: —" Foreground="#B7C0B8"/><Separator Margin="0,12"/><TextBlock x:Name="HomeSessionText" Text="Session: bereit"/><TextBlock x:Name="HomeRendererText" Text="Renderer: Glide64mk2" Margin="0,6,0,0"/><TextBlock x:Name="HomeInputText" Text="Input: Direct-XInput" Margin="0,6,0,0"/><Button Content="🎮  Zum Play Workspace" Click="Play_Click" Margin="0,18,0,0"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,6,0" Padding="14"><StackPanel><TextBlock Text="LIVE TRACKER" Foreground="#E3BB4C" FontWeight="Bold"/><TextBlock x:Name="HomeTrackerText" Text="Noch keine Live-Daten" FontSize="16" Foreground="#E8D69E" Margin="0,12,0,4" TextWrapping="Wrap"/><TextBlock x:Name="HomeRegionText" Text="Region: —"/><TextBlock x:Name="HomeChecksText" Text="Checks: —" Margin="0,6,0,0"/><TextBlock x:Name="HomeSnapshotText" Text="Datenstand: —" Margin="0,6,0,0" Foreground="#9DAA9F"/><Button Content="☷  Tracker öffnen" Click="TrackerPage_Click" Margin="0,18,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14"><StackPanel><TextBlock Text="DIREKTZUGRIFF" Foreground="#E3BB4C" FontWeight="Bold"/><Button Content="⚒  Randomizer" Click="Randomizer_Click" Margin="0,12,0,0"/><Button Content="▰  World / Map" Click="Map_Click" Margin="0,8,0,0"/><Button Content="⚙  Settings" Click="Settings_Click" Margin="0,8,0,0"/><Separator Margin="0,16"/><TextBlock Text="Home erzeugt keine eigenen Spielzustände. Alle Anzeigen spiegeln ausschließlich die vorhandenen Live-Daten." Foreground="#829087" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid>
   </Grid>

   <Grid Grid.Row="1" x:Name="SettingsWorkspace" Visibility="Collapsed" Margin="8,7,8,6">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource PanelBorder}" Padding="14,8"><StackPanel><TextBlock Text="⚙  SETTINGS" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="SettingsLockText" Text="Emulator- und Eingabeeinstellungen können vor dem Sessionstart geändert werden." Foreground="#9DAA9F" FontSize="10"/></StackPanel></Border>
    <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource PanelBorder}" Margin="0,0,6,0" Padding="16"><StackPanel><TextBlock Text="EMULATOR" Foreground="#E3BB4C" FontWeight="Bold" FontSize="15"/><TextBlock Text="Renderer" Margin="0,16,0,5"/><ComboBox x:Name="SettingsRendererBox" SelectedIndex="1" SelectionChanged="SettingsRenderer_Changed"><ComboBoxItem>Rice</ComboBoxItem><ComboBoxItem>Glide64mk2</ComboBoxItem></ComboBox><CheckBox x:Name="SettingsControllerBox" Content="Direct-XInput verwenden" IsChecked="True" Foreground="#F4E7C1" Margin="0,16,0,0" Checked="SettingsController_Changed" Unchecked="SettingsController_Changed"/><Separator Margin="0,18"/><TextBlock Text="EINGABEPROFIL" Foreground="#E3BB4C" FontWeight="Bold"/><TextBlock x:Name="InputProfilePathText" Text="UserData / Settings" Foreground="#829087" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/><Button x:Name="SaveInputBindingsButton" Content="✓  Belegung speichern &amp; anwenden" Click="SaveInputBindings_Click" Margin="0,14,0,0"/><Button x:Name="ResetInputBindingsButton" Content="↶  Standardbelegung" Click="ResetInputBindings_Click" Margin="0,7,0,0"/><TextBlock Text="Die Belegung wird persistent im UserData-Settings-Ordner gespeichert und beim nächsten Emulatorstart vom echten Mupen64Plus-Input-Plugin geladen." Foreground="#829087" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,6,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="CONTROLLER &amp; TASTATURBELEGUNG" Foreground="#E3BB4C" FontWeight="Bold" FontSize="15"/><TextBlock Text="Einmal starten, dann die komplette N64-Belegung der Reihe nach eingeben. Die N64-Belegung wird unten live visualisiert." Foreground="#9DAA9F" FontSize="10" Margin="0,3,0,8"/><WrapPanel><Button x:Name="ConfigureControllerButton" Content="🎮  Controller konfigurieren" Click="ConfigureController_Click" Margin="0,0,8,8"/><Button x:Name="ConfigureKeyboardButton" Content="⌨  Tastatur konfigurieren" Click="ConfigureKeyboard_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel><Border Grid.Row="1" Background="#08110D" BorderBrush="#725817" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8"><StackPanel><TextBlock Text="N64 CONTROLLER • AKTUELLE BELEGUNG" Foreground="#E3BB4C" FontWeight="Bold" Margin="0,0,0,5"/><WrapPanel x:Name="ControllerVisualPanel"/></StackPanel></Border><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InputBindingsPanel"/></ScrollViewer></Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16"><StackPanel><TextBlock Text="DARSTELLUNG" Foreground="#E3BB4C" FontWeight="Bold" FontSize="15"/><TextBlock Text="Theme" Margin="0,16,0,5"/><Border Style="{StaticResource InsetBorder}" Padding="10"><TextBlock Text="Aktives Design wird sofort auf die Oberfläche angewendet." Foreground="#F1D477" TextWrapping="Wrap"/></Border><TextBlock Text="Sprache" Margin="0,16,0,5"/><Border Style="{StaticResource InsetBorder}" Padding="10"><TextBlock Text="Deutsch / English"/></Border><TextBlock Text="Alle acht Designs besitzen eigene Material-, Rahmen- und Shell-Geometrie und können zur Laufzeit gewechselt werden." Foreground="#829087" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>
    </Grid>
   </Grid>

   <Grid Grid.Row="1" x:Name="MapWorkspace" Visibility="Collapsed" Margin="8,7,8,6">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource PanelBorder}" Padding="14,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▰  WORLD / MAP" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold" FontSize="18"/><TextBlock Text="Globale Übersicht • Live-Region und Checkstatus aus derselben Spielsitzung" Foreground="#9DAA9F" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" x:Name="WorldSnapshotText" Text="Datenstand: —" Foreground="#9DAA9F" VerticalAlignment="Center"/></Grid></Border>
    <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource PanelBorder}" Margin="0,0,6,0" Padding="10"><Grid><Image Source="/TrackerOfTime.V2.M8.5.Desktop;component/Assets/worldMap.png" Stretch="Uniform"/><Viewbox Stretch="Uniform" IsHitTestVisible="True"><Canvas x:Name="WorldChecksOverlay" Width="562" Height="318" Background="Transparent"/></Viewbox><Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D907100D" BorderBrush="#8C6824" BorderThickness="1" CornerRadius="4" Padding="10" Margin="10"><StackPanel><TextBlock Text="AKTUELL" Foreground="#E3BB4C" FontWeight="Bold"/><TextBlock x:Name="WorldCurrentRegionText" Text="Keine Live-Region" Foreground="#F1D477" FontSize="16" Margin="0,4,0,0"/><TextBlock x:Name="WorldAreaText" Text="Area: —"/></StackPanel></Border></Grid></Border>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource PanelBorder}" Padding="12"><StackPanel><TextBlock Text="REGIONSTATUS" Foreground="#E3BB4C" FontWeight="Bold"/><TextBlock x:Name="WorldChecksText" Text="Checks: —" Margin="0,8,0,0"/><TextBlock x:Name="WorldEvidenceText" Text="Status: —" Margin="0,5,0,0"/><TextBlock Text="Grün = vollständig • Orange = teilweise • Rot = offen. Es werden keine unbekannten Reachability-Daten erfunden." Foreground="#829087" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,6,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LIVE CHECKS DER AKTUELLEN MINIMAP" Foreground="#E3BB4C" FontWeight="Bold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="WorldRegionRowsPanel"/></ScrollViewer></Grid></Border></Grid>
    </Grid>
   </Grid>

   <Grid Grid.Row="1" x:Name="PlayWorkspace" Margin="8,7,8,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>

    <!-- MASTER SKETCH: session rail -->
    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,6,0"><Grid Margin="12,10,10,10"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="⚙  SPIEL &amp; SESSION" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
      <Border Grid.Row="1" Style="{StaticResource InsetBorder}" Padding="12" Margin="0,3,0,8"><StackPanel><TextBlock x:Name="GameTitleText" Text="Kein Spiel ausgewählt" Foreground="#D5A93A" FontFamily="Georgia" FontWeight="Bold" FontSize="18" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="GameProfileText" Text="ROM auswählen" Foreground="#AFA27C" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,14"/><TextBlock Text="◉ ROM GELADEN" Foreground="#D5A93A" FontWeight="Bold"/><TextBlock x:Name="RomPathText" Text="Keine ROM ausgewählt" Foreground="#BFC7C1" TextWrapping="Wrap" Margin="0,4,0,8"/><Button x:Name="ChooseRomButton" Content="📁  ROM wechseln …" Click="ChooseRom_Click"/></StackPanel></Border>
      <StackPanel Grid.Row="2"><TextBlock Text="◉  SESSION" Foreground="#E3BB4C" FontWeight="Bold" Margin="0,4,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Profil:"/><TextBlock Grid.Column="1" x:Name="ProfileText" Text="—"/><TextBlock Grid.Row="1" Text="Renderer:"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="RendererBox" SelectedIndex="1"><ComboBoxItem>Rice</ComboBoxItem><ComboBoxItem>Glide64mk2</ComboBoxItem></ComboBox><TextBlock Grid.Row="2" Text="Input:" Margin="0,8,0,0"/><CheckBox Grid.Row="2" Grid.Column="1" x:Name="ControllerBox" Content="Direct-XInput" IsChecked="True" Foreground="#F4E7C1" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Text="Status:" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="SessionStatusText" Text="● Bereit" Foreground="#53D764" Margin="0,8,0,0"/><TextBlock Grid.Row="4" Text="Spielzeit:" Margin="0,8,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="SessionTimeText" Text="00:00:00" Foreground="#E8D69E" Margin="0,8,0,0"/><TextBlock Grid.Row="5" Text="Host:" Margin="0,8,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="HostText" Text="nicht gestartet" Foreground="#9DAA9F" Margin="0,8,0,0"/></Grid></StackPanel>
      <StackPanel Grid.Row="4"><Button x:Name="StartButton" Content="▶  Spiel starten" Background="#235B29" Margin="0,10,0,3" IsEnabled="False" Click="StartGame_Click"/><Button x:Name="StopButton" Content="■  Spiel stoppen" IsEnabled="False" Click="StopGame_Click"/><Button x:Name="TrackerButton" Content="◉  Tracker starten" IsEnabled="False" Click="ProbeTracker_Click"/></StackPanel>
    </Grid></Border>

    <!-- MASTER SKETCH: dominant central game viewport -->
    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,6,0"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="🎮  SPIELANZEIGE" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Padding="8,3" Content="⛶" ToolTip="Emulatorfläche"/><Button Padding="8,3" Content="↻" ToolTip="Host erneut suchen" Click="Reattach_Click"/></StackPanel></Grid>
      <Border Grid.Row="1" BorderBrush="#C99C31" BorderThickness="2" CornerRadius="3" Background="#000000" Padding="3"><Grid><interop:EmbeddedGameHost x:Name="GameHost"/><StackPanel x:Name="EmulatorPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="▲" Foreground="#80661F" FontSize="64" HorizontalAlignment="Center"/><TextBlock Text="GAMECORE HOST" Foreground="#D5A93A" FontFamily="Georgia" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="Nach Spielstart wird hier das echte native Mupen-Fenster eingebettet." Foreground="#819087" Margin="0,10,0,0"/></StackPanel></Grid></Border>
    </Grid></Border>

    <!-- MASTER SKETCH: tracker HUD + event log -->
    <Grid Grid.Column="2" Margin="0,0,6,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="188"/></Grid.RowDefinitions>
      <Border Style="{StaticResource PanelBorder}"><Grid Margin="7"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="126"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="♜  TRACKER" Foreground="#E3BB4C" FontFamily="Georgia" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="LIVE • PROVEN" Foreground="#688B71" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="2,3"><UniformGrid x:Name="TrackerLiveGrid" Columns="7" HorizontalAlignment="Left" VerticalAlignment="Top"/></ScrollViewer>
